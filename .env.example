# 数据库连接串（本地开发）
DATABASE_URL="mysql://root:your-password@127.0.0.1:3306/snow_admin"

# JWT 签名密钥：必须 >=32 字符且非占位值
# 生成： openssl rand -hex 32
JWT_SECRET=""

NODE_ENV="development"

# 对外 API 允许的跨域来源，逗号分隔；默认 * 兼容公开 demo
# 生产建议收敛，如： CORS_ALLOW_ORIGINS="https://app.example.com,https://demo.example.com"
CORS_ALLOW_ORIGINS="*"

# ===== 以下仅 docker-compose 部署需要 =====
# MYSQL_ROOT_PASSWORD="generate-a-strong-password"
# MYSQL_DATABASE="snow_admin"
# 容器内 app 通过服务名 db 连库：
# DATABASE_URL="mysql://root:generate-a-strong-password@db:3306/snow_admin"
