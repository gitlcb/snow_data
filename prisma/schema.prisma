// snow_admin — Prisma schema
// 通用数据存储系统（迷你 BaaS）数据模型：User → App → Collection → Record

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  email     String   @unique
  password  String? // bcrypt hash；OAuth 用户无密码故可空
  name      String?
  role      String   @default("user") // user | superadmin
  disabled  Boolean  @default(false) // 禁用后不可登录
  oauthProvider String? @map("oauth_provider") // "linuxdo" | null
  oauthId       String? @map("oauth_id") // 第三方不可变用户 id
  avatarUrl     String? @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  apps App[]
  announcements Announcement[]

  @@unique([oauthProvider, oauthId])
  @@map("users")
}

model App {
  id          String   @id
  userId      String   @map("user_id")
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeys ApiKey[]
  records Record[]
  files   FileAsset[]
  endUsers   EndUser[]
  usageStats UsageStat[]

  @@index([userId])
  @@map("apps")
}

model ApiKey {
  id         String    @id
  appId      String    @map("app_id")
  name       String
  keyHash    String    @map("key_hash") // sha256 hash of full key
  keyPrefix  String    @map("key_prefix") // 展示用前缀，如 sk_live_abc...
  keyPlain   String?   @map("key_plain") @db.VarChar(80) // 完整明文，供随时查看/选用；老 key 为空不可回填
  scope      String    @default("readwrite") // readonly | readwrite
  expiresAt  DateTime? @map("expires_at") // 为空表示永不过期
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@index([keyHash])
  @@map("api_keys")
}

model Record {
  id         String   @id
  appId      String   @map("app_id")
  collection String
  ownerId    String?  @map("owner_id") // 终端用户归属；为空=App Key 写入的共享记录
  data       Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, collection, createdAt])
  @@index([appId, collection, ownerId])
  @@map("records")
}

model FileAsset {
  id          String   @id
  appId       String   @map("app_id")
  filename    String
  storagePath String   @map("storage_path")
  mimeType    String   @map("mime_type")
  size        Int
  createdAt   DateTime @default(now()) @map("created_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@map("files")
}

model EndUser {
  id        String   @id
  appId     String   @map("app_id")
  email     String
  password  String // bcrypt hash
  createdAt DateTime @default(now()) @map("created_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, email]) // 同 App 内邮箱唯一，跨 App 可重复
  @@index([appId])
  @@map("end_users")
}

model UsageStat {
  id          String   @id
  appId       String   @map("app_id")
  apiKeyId    String?  @map("api_key_id")
  bucket      DateTime // 截断到整点的时间桶
  method      String
  statusClass String   @map("status_class") // 2xx | 4xx | 5xx
  count       Int      @default(0)

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, apiKeyId, bucket, method, statusClass])
  @@index([appId, bucket])
  @@map("usage_stats")
}

// 全局系统配置：单行表（id 固定 "singleton"）
model SystemConfig {
  id                  String   @id @default("singleton")
  siteUrl             String   @default("") @map("site_url") @db.VarChar(255) // 对外站点地址；空=按请求自动识别
  registrationOpen    Boolean  @default(true) @map("registration_open")
  linuxdoEnabled      Boolean  @default(false) @map("linuxdo_enabled")
  linuxdoClientId     String?  @map("linuxdo_client_id")
  linuxdoClientSecret String?  @map("linuxdo_client_secret")
  uploadMaxBytes      Int      @default(10485760) @map("upload_max_bytes") // 10MB
  uploadAllowedMime   String   @default("") @db.VarChar(2000) @map("upload_allowed_mime") // 逗号分隔，空=全允许
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

model Announcement {
  id        String   @id
  authorId  String   @map("author_id")
  title     String
  body      String   @db.Text
  type      String   @default("info") // info | warning | danger
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([published, createdAt])
  @@map("announcements")
}
